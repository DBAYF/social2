# Firebase (Auth + Firestore + Storage only)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Lovable backend (AI and other server features)
# Set this to your Lovable API base URL after deploy
VITE_LOVABLE_API_URL=

# Optional: Use Firebase Emulators in development
VITE_USE_EMULATORS=false

# ⛔ NEVER ADD TO FRONTEND:
# - OpenAI/API keys (Lovable backend only)
# - Firebase Admin / service account credentials
